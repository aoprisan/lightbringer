node_modules/

# Build output — compiled from *.ts by `npm run build` (and in CI).
/app.js
/pentagram.js
/necro.js
/eldritch.js
/werewolf.js

# Dev-only map previews (tools/preview-city.mjs) — local artifacts, never shipped.
/*-preview.png

# macOS junk
.DS_Store

# Original full-res art generations (~5MB each). The prompt .txt files are
# tracked as the regeneration recipe; the shipped, optimized sprites live in
# art/*.png. The 2048px source PNGs are kept locally only.
art/prompts/*.png

# Full-res city establishing-art generations (~7.5MB each). The shipped,
# optimized versions live in art/city-*.jpg; the source PNGs are local-only.
art-prompts/city-*.png

# Full-res per-city sprite generations (~6MB each). tools/process-city-sprites.py
# turns these into the shipped art/<city>/*.png; the 2048px sources are local-only.
art-prompts/*/*.png
